# Postgres database; the app creates and updates its schema at startup.
DATABASE_URL=postgres://user:password@localhost:5432/lwt
# Secret used to sign session tokens (AppSettings:Secret in the old .NET API, to keep its tokens valid).
LWT_JWT_SECRET=change-me-to-a-long-random-string
# Public half of the age key that encrypts the hourly backups (docker compose only, see "Backups" in README.md).
BACKUP_AGE_RECIPIENT=age1...
